rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'pp@gmail.com'; }
    function post(pid) { return get(/databases/$(db)/documents/posts/$(pid)).data; }

    // Public catalogs: needed before sign-up. Only admin edits.
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /companies/{id} { allow read: if true; allow write: if isAdmin(); }

    // Profiles (no phone numbers here).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid && request.resource.data.active == true;
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.active == resource.data.active
        && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin();
    }

    // Phone numbers: owner, admin, or someone whose payment for this member is unlocked.
    match /private/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (get(/databases/$(db)/documents/unlocks/$(request.auth.uid + '_' + uid)).data.status == 'unlocked'
          && !(exists(/databases/$(db)/documents/users/$(uid))
            && get(/databases/$(db)/documents/users/$(uid)).data.get('hidePhone', false) == true)));
      allow write: if request.auth.uid == uid || isAdmin();
    }

    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /interests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || post(pid).ownerId == request.auth.uid);
        allow create, update: if signedIn() && post(pid).active == true && (request.auth.uid == uid
          || (uid.matches('demo_.*') && post(pid).ownerId == request.auth.uid
            && get(/databases/$(db)/documents/settings/app).data.demoMode == true));
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin() || post(pid).ownerId == request.auth.uid);
      }
    }

    // Reviews: only between members whose contact was unlocked (either direction). Id "<reviewer>_<target>".
    function unlocked(a, b) { return get(/databases/$(db)/documents/unlocks/$(a + '_' + b)).data.status == 'unlocked'; }
    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && (unlocked(request.auth.uid, request.resource.data.targetId) || unlocked(request.resource.data.targetId, request.auth.uid));
      allow delete: if isAdmin() || (signedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // In-app chat for hidden numbers. Thread id = unlock id "<payer>_<member>"; open once that chat unlock is approved.
    function chatMember(cid) {
      let u = get(/databases/$(db)/documents/unlocks/$(cid)).data;
      return signedIn() && u.status == 'unlocked' && u.get('kind', 'phone') == 'chat'
        && (u.userId == request.auth.uid || u.interestId == request.auth.uid);
    }
    match /chats/{cid}/messages/{mid} {
      allow read: if chatMember(cid);
      allow create: if chatMember(cid) && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow update: if chatMember(cid) && resource.data.from != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deliveredAt", "readAt"]);
    }

    // Payment proofs. Id is "<payerUid>_<memberUid>".
    match /unlocks/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid
        || (resource.data.get('kind', 'phone') == 'chat' && resource.data.interestId == request.auth.uid));
      allow create: if payProof(id);
      // A payer may resubmit after the admin rejected an earlier proof.
      allow update: if isAdmin() || (resource.data.status == 'rejected' && payProof(id));
      allow delete: if isAdmin();
    }
    function payProof(id) {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.interestId
        && post(request.resource.data.postId).ownerId == request.auth.uid
        && exists(/databases/$(db)/documents/posts/$(request.resource.data.postId)/interests/$(request.resource.data.interestId))
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'unlocked'
            && get(/databases/$(db)/documents/settings/app).data.instantUnlock == true));
    }

    // WhatsApp phone verification (works before sign-up). Doc id = phone digits.
    function otpSecret(p) { return get(/databases/$(db)/documents/otpSecrets/$(p)).data; }
    match /otpSecrets/{p} { allow read, write: if isAdmin(); }
    match /otpPool/{id} { allow read, write: if isAdmin(); }
    match /otpRequests/{p} {
      allow get: if true;
      allow list, delete: if isAdmin();
      // New request (or fresh request after expiry): pending, no attempts, no code assigned.
      allow create: if newOtpRequest(p);
      allow update: if isAdmin() || (resource.data.status != 'verified' && newOtpRequest(p))
        || (resource.data.status == 'sent'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guess', 'attempts', 'status'])
          && request.resource.data.attempts == resource.data.attempts + 1
          && request.resource.data.attempts <= 5
          && request.resource.data.guess is string
          && (request.resource.data.status == 'sent'
            || (request.resource.data.status == 'verified' && request.resource.data.guess == otpSecret(p).code)));
    }
    function newOtpRequest(p) {
      let d = request.resource.data;
      return d.keys().hasOnly(['phone', 'status', 'attempts', 'createdAt']) && d.status == 'pending' && d.attempts == 0
        && d.createdAt == request.time && d.phone is string && d.phone.replace('[^0-9]', '') == p && p.size() >= 10 && p.size() <= 15;
    }
    match /verifiedPhones/{p} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if exists(/databases/$(db)/documents/otpSecrets/$(p))
        && request.resource.data.code == otpSecret(p).code
        && request.time < otpSecret(p).sentAt + duration.value(15, 'm')
        && getAfter(/databases/$(db)/documents/otpRequests/$(p)).data.status == 'verified'
        && getAfter(/databases/$(db)/documents/otpRequests/$(p)).data.guess == request.resource.data.code;
    }
  }
}
